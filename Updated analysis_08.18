# Install packages
install.packages("openxlsx")
install.packages("gtsummary")
install.packages("logistf") 
install.packages("openxlsx")

library(openxlsx)
library(dplyr)
library(gtsummary)
library(logistf)
library(openxlsx)

# Import dataset
file_path <- " "    # Based on file path
demographics <- read.xlsx(file_path, sheet = "Demographics")
baseline_devices <- read.xlsx(file_path, sheet = "All Baseline+devices")
preferred_speed <- read.xlsx(file_path, sheet = "WalkingSpeed")


# ————————————————— Section 1: Demographic Analysis ————————————————————————————
# Define
demographics <- demographics %>%
  filter(!subject %in% c("8-A", "17-A")) %>%
  mutate(
    sex_cat = case_when(
      sex == "Male"   ~ 0,
      sex == "Female" ~ 1,
      TRUE ~ NA_real_),
    
    race_cat = case_when(
      `race/ethnicity` == "White" ~ 0,
      `race/ethnicity` == "White/ Latino" ~ 0,
      `race/ethnicity` == "Black" ~ 1,
      `race/ethnicity` == "Asian" ~ 2,
      TRUE ~ NA_real_),
    
    visual_acuity = factor(
      `visual.acuity`,
      levels = c(
        "No vision",
        "Able to see lights",
        "Able to see shapes",
        "Able to read large text")))


# Demographic Table
demographic_table <- tbl_summary(
  mutate(
    demographics,
    sex_cat = factor(sex_cat, levels = c(0, 1), labels = c("Male", "Female")),
    race_cat = factor(race_cat, levels = c(0, 1, 2), labels = c("White", "Black", "Asian")),
    visual_acuity = factor(
      visual_acuity,
      levels = c("No vision", "Able to see lights", "Able to see shapes", "Able to read large text")))
  
  [, c("sex_cat", "age", "race_cat", "visual_acuity")],
  statistic = list(
    all_categorical() ~ "{n} ({p}%)",
    age ~ "{median} [{p25}, {p75}]"),
  
  label = list(
    sex_cat    ~ "Sex",
    age        ~ "Age",
    race_cat   ~ "Race/Ethnicity",
    visual_acuity ~ "Visual Acuity"),
  missing = "no")

# Display table
demographic_table
# ————————————————————————————————————————————————————————————————————————————



# ————————————————— Section 2: Logistics Regression ————————————————————————————
# Outcome Variable
analysis <- baseline_devices

analysis$completed <- ifelse(
  analysis$success == "y", 1, 0)

# Goodmaps as reference
analysis$device <- factor(
  analysis$device,
  levels = c("Goodmaps", "Clew", "NaviLens"))

# Age & Visual Acuity
analysis <- merge(
  analysis,
  demographics[, c("subject", "age", "visual_acuity")],
  by = "subject")

analysis$visual_acuity <- factor(
  analysis$visual_acuity,
  levels = c(
    "No vision",
    "Able to see lights",
    "Able to see shapes",
    "Able to read large text"),
  ordered = TRUE)

# Crude logistic regression model
logistics_crude <- glm(
  completed ~ device,
  family = binomial,
  data = analysis)

summary(logistics_crude)
exp(cbind(OR = coef(logistics_crude), confint(logistics_crude)))

# Age-adjusted model
logistics_age <- glm(
  completed ~ device + age,
  family = binomial,
  data = analysis)

summary(logistics_age)
exp(cbind(OR = coef(logistics_age), confint(logistics_age)))

# Visual acuity-adjusted model
logistics_va <- glm(
  completed ~ device + visual_acuity,
  family = binomial,
  data = analysis)

summary(logistics_va)
exp(cbind(OR = coef(logistics_va), confint(logistics_va)))
# ————————————————————————————————————————————————————————————————————————————



# ————————————————— Section 3: Linear Regression ————————————————————————————
# Preferred walking speed
colnames(preferred_speed)[4] <- "preferred_speed"

analysis <- merge(
  analysis, preferred_speed[, c("subject", "preferred_speed")], by = "subject")

# Route distance table
route_distance <- data.frame(
  route = c(
    "S2", "S2R",
    "S12", "S12R",
    "S4", "S6",
    "L13", "L13R",
    "L15", "L14",
    "L10", "L10R"),
  
  meters = c(
    47.5, 47.5,
    32.6, 32.6,
    23.5, 30.8,
    64.6, 64.6,
    58.0, 61.9,
    70.1, 68.3))

analysis <- merge(
  analysis, route_distance, by = "route")

# Successful routes only
speed_analysis <- analysis[analysis$completed == 1,]

# Convert time to numeric
speed_analysis$time <- as.numeric(speed_analysis$time)

# Navigation walking speed
speed_analysis$navigation_speed <- speed_analysis$meters / speed_analysis$time



# Crude linear regression model
linear_crude <- lm(navigation_speed ~ device, data = speed_analysis)

summary(linear_crude)
confint(linear_crude)

# Preferred speed-adjusted model
linear_speed <- lm(navigation_speed ~ device + preferred_speed, data = speed_analysis)

summary(linear_speed)
confint(linear_speed)
# ————————————————————————————————————————————————————————————————————————————



# ————————— Section 4: Clew vs NaviLens (Clew as reference category) ———————————
analysis$device_clew_ref <- factor(analysis$device,
  levels = c("Clew", "Goodmaps", "NaviLens"))

speed_analysis$device_clew_ref <- factor(speed_analysis$device,
  levels = c("Clew", "Goodmaps", "NaviLens"))


# Logistic regression: route completion
# Crude model
logistics_clew_crude <- glm(
  completed ~ device_clew_ref, family = binomial, data = analysis)

summary(logistics_clew_crude)
exp(cbind(OR = coef(logistics_clew_crude), confint(logistics_clew_crude)))


# Age-adjusted model
logistics_clew_age <- glm(
  completed ~ device_clew_ref + age,
  family = binomial,
  data = analysis)

summary(logistics_clew_age)
exp(cbind(OR = coef(logistics_clew_age), confint(logistics_clew_age)))


# Visual acuity-adjusted model
logistics_clew_va <- glm(
  completed ~ device_clew_ref + visual_acuity, family = binomial, data = analysis)

summary(logistics_clew_va)
exp(cbind(OR = coef(logistics_clew_va), confint(logistics_clew_va)))


# Linear regression: navigation walking speed
# Crude model
linear_clew_crude <- lm(
  navigation_speed ~ device_clew_ref, data = speed_analysis)

summary(linear_clew_crude)
confint(linear_clew_crude)


# Preferred speed-adjusted model
linear_clew_speed <- lm(
  navigation_speed ~ device_clew_ref + preferred_speed, data = speed_analysis)

summary(linear_clew_speed)
confint(linear_clew_speed)

# ————————————————————————————————————————————————————————————————————————————



# —————————————————— Section 5: Baseline Reference Analyses ——————————————————
# Baseline-inclusive cohort
analysis_baseline <- baseline_devices

analysis_baseline$completed <- ifelse(
  analysis_baseline$success == "y", 1, 0)

# Baseline as reference category
analysis_baseline$device <- factor(
  analysis_baseline$device,
  levels = c("Baseline", "Goodmaps", "Clew", "NaviLens"))

# Merge demographic variables
analysis_baseline <- merge(
  analysis_baseline,
  demographics[, c("subject", "age", "visual_acuity")],
  by = "subject")

analysis_baseline$visual_acuity <- factor(
  analysis_baseline$visual_acuity,
  levels = c(
    "No vision",
    "Able to see lights",
    "Able to see shapes",
    "Able to read large text"),
  ordered = TRUE)


# Logistic regression
# Crude model
baseline_crude <- glm(completed ~ device, family = binomial, data = analysis_baseline)

summary(baseline_crude)
exp(cbind(OR = coef(baseline_crude), confint(baseline_crude)))


# Age-adjusted model
baseline_age <- glm(
  completed ~ device + age, family = binomial, data = analysis_baseline)

summary(baseline_age)
exp(cbind(OR = coef(baseline_age), confint(baseline_age)))


# Visual acuity-adjusted model
baseline_va <- glm(
  completed ~ device + visual_acuity, family = binomial, data = analysis_baseline)

summary(baseline_va)
exp(cbind(OR = coef(baseline_va), confint(baseline_va)))


# ————————————————— Linear Regression ————————————————————————————————

# Merge preferred walking speed
analysis_baseline <- merge(
  analysis_baseline,
  preferred_speed[, c("subject", "preferred_speed")],
  by = "subject")

# Merge route distance
analysis_baseline <- merge(analysis_baseline, route_distance, by = "route")

# Successful routes only
speed_baseline <- analysis_baseline[analysis_baseline$completed == 1, ]

# Convert time to numeric
speed_baseline$time <- as.numeric(speed_baseline$time)

# Navigation walking speed
speed_baseline$navigation_speed <- speed_baseline$meters / speed_baseline$time


# Crude linear regression model
baseline_linear_crude <- lm(navigation_speed ~ device, data = speed_baseline)

summary(baseline_linear_crude)
confint(baseline_linear_crude)


# Preferred speed-adjusted model
baseline_linear_speed <- lm(
  navigation_speed ~ device + preferred_speed, data = speed_baseline)

summary(baseline_linear_speed)
confint(baseline_linear_speed)

# ————————————————————————————————————————————————————————————————————————————



# ———————————————— Section 6: Multiple Comparison Adjustments ————————————————
# A. Pairwise comparisons among the 3 navigation apps - Tukey adjustment
# ---------------- Route Completion: Logistic Regression ----------------
# Crude model
emm_log_crude <- emmeans(logistics_crude, ~ device)
pairs(emm_log_crude, adjust = "tukey", type = "response")

# Age-adjusted model
emm_log_age <- emmeans(logistics_age, ~ device)
pairs(emm_log_age, adjust = "tukey", type = "response")

# Visual acuity-adjusted model
emm_log_va <- emmeans(logistics_va, ~ device)
pairs(emm_log_va, adjust = "tukey", type = "response")


# ------------- Navigation Walking Speed: Linear Regression -------------
# Crude model
emm_speed_crude <- emmeans(linear_crude, ~ device)
pairs(emm_speed_crude, adjust = "tukey")

# Preferred walking speed-adjusted model
emm_speed_adjusted <- emmeans(linear_speed, ~ device)
pairs(emm_speed_adjusted, adjust = "tukey")



# B. Comparisons of each navigation app vs Baseline - Dunnett adjustment
# ---------- Route Completion: Logistic Regression ----------
# Crude model
emm_base_log_crude <- emmeans(baseline_crude, ~ device)
contrast(
  emm_base_log_crude,
  method = "trt.vs.ctrl",
  ref = "Baseline",
  adjust = "dunnettx",
  type = "response")

# Age-adjusted model
emm_base_log_age <- emmeans(baseline_age, ~ device)
contrast(
  emm_base_log_age,
  method = "trt.vs.ctrl",
  ref = "Baseline",
  adjust = "dunnettx",
  type = "response")

# Visual acuity-adjusted model
emm_base_log_va <- emmeans(baseline_va, ~ device)
contrast(
  emm_base_log_va,
  method = "trt.vs.ctrl",
  ref = "Baseline",
  adjust = "dunnettx",
  type = "response")


# ---------- Navigation Walking Speed: Linear Regression ----------
# Crude model
emm_base_speed_crude <- emmeans(baseline_linear_crude, ~ device)
contrast(
  emm_base_speed_crude,
  method = "trt.vs.ctrl",
  ref = "Baseline",
  adjust = "dunnettx")


# Preferred walking speed-adjusted model
emm_base_speed_adjusted <- emmeans(baseline_linear_speed, ~ device)
contrast(
  emm_base_speed_adjusted,
  method = "trt.vs.ctrl",
  ref = "Baseline",
  adjust = "dunnettx")
# ————————————————————————————————————————————————————————————————————————————

