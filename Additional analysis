# Install packages
install.packages("openxlsx")
install.packages("gtsummary")
install.packages("logistf") 
install.packages("openxlsx")

library(openxlsx)
library(dplyr)
library(gtsummary)
library(logistf)
library(openxlsx)

# Import dataset
file_path <- " "    # Based on file path
demographics <- read.xlsx(file_path, sheet = "Demographics")
baseline_devices <- read.xlsx(file_path, sheet = "All Baseline+devices")
preferred_speed <- read.xlsx(file_path, sheet = "WalkingSpeed")


# ————————————————— Section 1: Demographic Analysis ————————————————————————————
# Define
demographics <- demographics %>%
  filter(!subject %in% c("8-A", "17-A")) %>%
  mutate(
    sex_cat = case_when(
      sex == "Male"   ~ 0,
      sex == "Female" ~ 1,
      TRUE ~ NA_real_),
    
    race_cat = case_when(
      `race/ethnicity` == "White" ~ 0,
      `race/ethnicity` == "White/ Latino" ~ 0,
      `race/ethnicity` == "Black" ~ 1,
      `race/ethnicity` == "Asian" ~ 2,
      TRUE ~ NA_real_),
    
    visual_acuity = factor(
      `visual.acuity`,
      levels = c(
        "No vision",
        "Able to see lights",
        "Able to see shapes",
        "Able to read large text")))


# Demographic Table
demographic_table <- tbl_summary(
  mutate(
    demographics,
    sex_cat = factor(sex_cat, levels = c(0, 1), labels = c("Male", "Female")),
    race_cat = factor(race_cat, levels = c(0, 1, 2), labels = c("White", "Black", "Asian")),
    visual_acuity = factor(
      visual_acuity,
      levels = c("No vision", "Able to see lights", "Able to see shapes", "Able to read large text")))
  
  [, c("sex_cat", "age", "race_cat", "visual_acuity")],
  statistic = list(
    all_categorical() ~ "{n} ({p}%)",
    age ~ "{median} [{p25}, {p75}]"),
  
  label = list(
    sex_cat    ~ "Sex",
    age        ~ "Age",
    race_cat   ~ "Race/Ethnicity",
    visual_acuity ~ "Visual Acuity"),
  missing = "no")

# Display table
demographic_table
# ————————————————————————————————————————————————————————————————————————————



# ————————————————— Section 2: Logistics Regression ————————————————————————————
# Outcome Variable
analysis <- baseline_devices

analysis$completed <- ifelse(
  analysis$success == "y", 1, 0)

# Goodmaps as reference
analysis$device <- factor(
  analysis$device,
  levels = c("Goodmaps", "Clew", "NaviLens"))

# Age & Visual Acuity
analysis <- merge(
  analysis,
  demographics[, c("subject", "age", "visual_acuity")],
  by = "subject")

analysis$visual_acuity <- factor(
  analysis$visual_acuity,
  levels = c(
    "No vision",
    "Able to see lights",
    "Able to see shapes",
    "Able to read large text"),
  ordered = TRUE)

# Crude logistic regression model
logistics_crude <- glm(
  completed ~ device,
  family = binomial,
  data = analysis)

summary(logistics_crude)
exp(cbind(OR = coef(logistics_crude), confint(logistics_crude)))

# Age-adjusted model
logistics_age <- glm(
  completed ~ device + age,
  family = binomial,
  data = analysis)

summary(logistics_age)
exp(cbind(OR = coef(logistics_age), confint(logistics_age)))

# Visual acuity-adjusted model
logistics_va <- glm(
  completed ~ device + visual_acuity,
  family = binomial,
  data = analysis)

summary(logistics_va)
exp(cbind(OR = coef(logistics_va), confint(logistics_va)))
# ————————————————————————————————————————————————————————————————————————————



# ————————————————— Section 3: Linear Regression ————————————————————————————
# Preferred walking speed
colnames(preferred_speed)[4] <- "preferred_speed"

analysis <- merge(
  analysis, preferred_speed[, c("subject", "preferred_speed")], by = "subject")

# Route distance table
route_distance <- data.frame(
  route = c(
    "S2", "S2R",
    "S12", "S12R",
    "S4", "S6",
    "L13", "L13R",
    "L15", "L14",
    "L10", "L10R"),
  
  meters = c(
    47.5, 47.5,
    32.6, 32.6,
    23.5, 30.8,
    64.6, 64.6,
    58.0, 61.9,
    70.1, 68.3))

analysis <- merge(
  analysis, route_distance, by = "route")

# Successful routes only
speed_analysis <- analysis[analysis$completed == 1,]

# Convert time to numeric
speed_analysis$time <- as.numeric(speed_analysis$time)

# Navigation walking speed
speed_analysis$navigation_speed <- speed_analysis$meters / speed_analysis$time



# Crude linear regression model
linear_crude <- lm(navigation_speed ~ device, data = speed_analysis)

summary(linear_crude)
confint(linear_crude)

# Preferred speed-adjusted model
linear_speed <- lm(navigation_speed ~ device + preferred_speed, data = speed_analysis)

summary(linear_speed)
confint(linear_speed)
# ————————————————————————————————————————————————————————————————————————————



# ————————— Section 4: Clew vs NaviLens (Clew as reference category) ———————————
analysis$device_clew_ref <- factor(analysis$device,
  levels = c("Clew", "Goodmaps", "NaviLens"))

speed_analysis$device_clew_ref <- factor(speed_analysis$device,
  levels = c("Clew", "Goodmaps", "NaviLens"))


# Logistic regression: route completion
# Crude model
logistics_clew_crude <- glm(
  completed ~ device_clew_ref, family = binomial, data = analysis)

summary(logistics_clew_crude)
exp(cbind(OR = coef(logistics_clew_crude), confint(logistics_clew_crude)))


# Age-adjusted model
logistics_clew_age <- glm(
  completed ~ device_clew_ref + age,
  family = binomial,
  data = analysis)

summary(logistics_clew_age)
exp(cbind(OR = coef(logistics_clew_age), confint(logistics_clew_age)))


# Visual acuity-adjusted model
logistics_clew_va <- glm(
  completed ~ device_clew_ref + visual_acuity, family = binomial, data = analysis)

summary(logistics_clew_va)
exp(cbind(OR = coef(logistics_clew_va), confint(logistics_clew_va)))


# Linear regression: navigation walking speed
# Crude model
linear_clew_crude <- lm(
  navigation_speed ~ device_clew_ref, data = speed_analysis)

summary(linear_clew_crude)
confint(linear_clew_crude)


# Preferred speed-adjusted model
linear_clew_speed <- lm(
  navigation_speed ~ device_clew_ref + preferred_speed, data = speed_analysis)

summary(linear_clew_speed)
confint(linear_clew_speed)

